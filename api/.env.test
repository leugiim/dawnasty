# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

###> doctrine/doctrine-bundle ###
# El "dbname_suffix" que trae por defecto config/packages/doctrine.yaml
# (when@test) no tiene ningún efecto sobre una conexión SQLite basada en
# "path" (solo aplica al parámetro "dbname" de MySQL/Postgres) — con él,
# el entorno de test usaba literalmente el mismo var/data.db que dev. Se
# fija aquí una URL de test explícita, en su propio fichero.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
###< doctrine/doctrine-bundle ###
